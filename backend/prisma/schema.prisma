// Multi-Provider Marketplace - Prisma Database Schema
// Fully normalized matching Phase 1 Specifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. USERS & ROLES
model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  role             String          @default("CUSTOMER") // SUPER_ADMIN, OPERATIONS_ADMIN, CONTENT_MANAGER, SUPPORT, PROVIDER, CUSTOMER
  isActive         Boolean         @default(true)
  isEmailVerified  Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  providerProfile  Provider?
  providerStaff    ProviderStaff[]
  bookings         Booking[]
  reviews          Review[]
  favourites       Favourite[]
  notifications    Notification[]
  sentMessages     Message[]       @relation("SenderMessages")
  receivedMessages Message[]       @relation("ReceiverMessages")
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

model Permission {
  id          String   @id @default(uuid())
  role        String
  resource    String   // e.g. "listings", "providers", "bookings", "cms", "users"
  action      String   // "create", "read", "update", "delete", "moderate", "all"
  createdAt   DateTime @default(now())

  @@unique([role, resource, action])
}

// 2. PROVIDERS & STAFF
model Provider {
  id                 String          @id @default(uuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  tradeLicenseNo     String?
  taxId              String?
  phone              String
  email              String
  address            String?
  city               String?
  country            String          @default("Pakistan")
  bio                String?
  logoUrl            String?
  bannerUrl          String?
  verificationStatus String          @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  verificationNotes  String?
  verificationDocs   String?         // JSON string or doc URL list
  rating             Float           @default(5.0)
  reviewCount        Int             @default(0)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  staff              ProviderStaff[]
  listings           Listing[]
  bookings           Booking[]
  reviews            Review[]

  @@index([verificationStatus])
}

model ProviderStaff {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("MANAGER") // OWNER, MANAGER, AGENT
  permissions String?  // JSON string
  createdAt   DateTime @default(now())

  @@unique([providerId, userId])
}

// 3. DESTINATIONS & CATEGORIES
model Destination {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  country     String    @default("Pakistan")
  region      String?
  description String?
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listings    Listing[]

  @@index([slug])
  @@index([isFeatured])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?   // Lucide icon name or SVG
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listings    Listing[]

  @@index([slug])
}

// 4. LISTINGS, PACKAGES, ITINERARIES & MEDIA
model Listing {
  id                 String          @id @default(uuid())
  providerId         String
  provider           Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  destinationId      String
  destination        Destination     @relation(fields: [destinationId], references: [id])
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id])
  title              String
  slug               String          @unique
  shortDescription   String
  fullDescription    String
  status             String          @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, PUBLISHED, REJECTED, SUSPENDED, ARCHIVED
  rejectionReason    String?
  basePrice          Float
  currency           String          @default("PKR")
  durationDays       Int             @default(1)
  maxGuests          Int             @default(10)
  meetingPoint       String?
  inclusions         String?         // JSON array string: ["Guide", "Equipment", "Meals"]
  exclusions         String?         // JSON array string: ["Personal Insurance", "Tips"]
  highlights         String?         // JSON array string: ["Mountain pass", "Bonfire"]
  cancellationPolicy String?
  termsAndConditions String?
  isFeatured         Boolean         @default(false)
  featuredPriority   Int             @default(0)
  rating             Float           @default(5.0)
  reviewCount        Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  packages           Package[]
  itineraryItems     ItineraryItem[]
  media              Media[]
  availability       Availability[]
  bookings           Booking[]
  reviews            Review[]
  discounts          Discount[]
  favourites         Favourite[]

  @@index([status])
  @@index([destinationId])
  @@index([categoryId])
  @@index([providerId])
  @@index([basePrice])
  @@index([rating])
}

model Package {
  id              String    @id @default(uuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Float
  discountedPrice Float?
  minGuests       Int       @default(1)
  maxGuests       Int       @default(10)
  durationDays    Int       @default(1)
  createdAt       DateTime  @default(now())

  bookings        Booking[]
}

model ItineraryItem {
  id            String   @id @default(uuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dayNumber     Int
  title         String
  description   String
  mealsIncluded String?
  accommodation String?
  createdAt     DateTime @default(now())

  @@index([listingId, dayNumber])
}

model Media {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Availability {
  id             String   @id @default(uuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date           String   // Format YYYY-MM-DD
  availableSlots Int      @default(10)
  priceOverride  Float?
  isBlocked      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([listingId, date])
}

// 5. BOOKINGS & TRANSACTIONS
model Booking {
  id                String        @id @default(uuid())
  bookingReference  String        @unique // e.g. "BK-2026-8812"
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  providerId        String
  provider          Provider      @relation(fields: [providerId], references: [id])
  listingId         String
  listing           Listing       @relation(fields: [listingId], references: [id])
  packageId         String?
  package           Package?      @relation(fields: [packageId], references: [id])
  startDate         String        // YYYY-MM-DD
  endDate           String?       // YYYY-MM-DD
  guestsCount       Int           @default(1)
  unitPrice         Float
  totalPrice        Float
  discountAmount    Float         @default(0)
  finalPrice        Float
  currency          String        @default("PKR")
  status            String        @default("PENDING") // PENDING, CONFIRMED, REJECTED, CANCELLED, COMPLETED
  customerNotes     String?
  providerNotes     String?
  rejectionReason   String?
  cancellationReason String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             BookingItem[]
  transactions      Transaction[]
  review            Review?
  messages          Message[]

  @@index([status])
  @@index([userId])
  @@index([providerId])
}

model BookingItem {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
}

model Transaction {
  id                   String   @id @default(uuid())
  bookingId            String
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionReference String   @unique
  amount               Float
  currency             String   @default("PKR")
  status               String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod        String   @default("BANK_TRANSFER") // BANK_TRANSFER, JAZZCASH, EASYPAISA, CREDIT_CARD
  createdAt            DateTime @default(now())
}

// 6. RATINGS & REVIEWS
model Review {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  providerId       String
  provider         Provider @relation(fields: [providerId], references: [id])
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id])
  rating           Int      // 1 to 5
  title            String
  comment          String
  status           String   @default("PUBLISHED") // PUBLISHED, HIDDEN, REPORTED
  reportReason     String?
  providerResponse String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([listingId])
  @@index([providerId])
  @@index([status])
}

// 7. DISCOUNTS & COUPONS
model Discount {
  id              String    @id @default(uuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title           String
  code            String?
  percentage      Float     @default(0)
  fixedAmount     Float     @default(0)
  startDate       String    // YYYY-MM-DD
  endDate         String    // YYYY-MM-DD
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([listingId])
  @@index([isActive])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  percentage      Float     @default(0)
  fixedAmount     Float     @default(0)
  minSpend        Float     @default(0)
  validFrom       String
  validTo         String
  usageLimit      Int       @default(100)
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

// 8. FAVOURITES, NOTIFICATIONS & MESSAGING
model Favourite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, BOOKING_UPDATE, VERIFICATION, REVIEW, SYSTEM
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Message {
  id        String   @id @default(uuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver  User     @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([senderId, receiverId])
}

// 9. SUPPORT TICKETS & AUDIT LOGS
model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  description String
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     String   // e.g. "PROVIDER_APPROVED", "LISTING_MODERATED", "BOOKING_STATUS_CHANGED"
  entityType String   // "Provider", "Listing", "Booking", "Review", "User"
  entityId   String
  metadata   String?  // JSON string of before/after or payload
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
}

// 10. CMS & CONTENT MANAGEMENT
model CMSBanner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  tag         String?
  imageUrl    String
  linkUrl     String?
  position    String   @default("HOMEPAGE_HERO") // HOMEPAGE_HERO, PROMO_SECTION, SIDEBAR
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}
